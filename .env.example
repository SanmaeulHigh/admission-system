# 웹 화면 설정 — 이 파일을 .env.production(배포) / .env.local(개발)로 복사해서 쓴다.
# .env.* 파일은 절대 git 에 올리지 않는다(.gitignore 에 들어 있음).

# Supabase 프로젝트 주소와 anon(공개) 키 — Supabase 대시보드 > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (선택) 교외 접속 주소의 호스트 이름. 이 주소로 접속하면 100MB 넘는 PDF 업로드를 막고
# 교내 주소에서 올리라고 안내한다(Cloudflare 터널은 요청당 100MB 제한). 터널을 안 쓰면 비워 둔다.
# 예: VITE_TUNNEL_HOST=ipsi.example.org
VITE_TUNNEL_HOST=

# (선택) 온라인 서류작성기 이용 집계(구글 Apps Script) — 안 쓰면 비워 둔다
VITE_FORM_TRACKING_URL=
VITE_FORM_TRACKING_KEY=

# 주의: service_role 키는 절대 여기에 넣지 않는다(VITE_ 값은 브라우저에 그대로 드러난다).
# 문자·메일·NEIS 키는 Edge Function 비밀값(Secrets)에 넣는다 — INSTALL.md 3단계.
